# Container env for a Gmail / Google Workspace instance.
# Password on the phone = a Google App Password (requires 2-Step Verification);
# Z-Push's IMAP backend has no OAuth/XOAUTH2 support.
TIMEZONE=UTC
ZPUSH_HOST=gmail-eas.example.com

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_OPTIONS=/ssl/norsh

# English-UI Gmail names. If your Gmail UI language is not English the
# [Gmail]/... names may be localized (and "[Gmail]" may be "[Google Mail]").
# Values must be the RAW IMAP names (modified UTF-7) — see README "Check folder names".
IMAP_FOLDER_PREFIX=
IMAP_FOLDER_PREFIX_IN_INBOX=false
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_SENT=[Gmail]/Sent Mail
IMAP_FOLDER_DRAFT=[Gmail]/Drafts
IMAP_FOLDER_TRASH=[Gmail]/Trash
IMAP_FOLDER_SPAM=[Gmail]/Spam
# No "Archive" folder in Gmail; leave a non-existent name so nothing is mis-typed
IMAP_FOLDER_ARCHIVE=Archive
# Hide label views that duplicate every message (substring match, UTF-8, "|"-separated)
IMAP_EXCLUDED_FOLDERS=[Gmail]/All Mail|[Gmail]/Important|[Gmail]/Starred

IMAP_SMTP_METHOD=smtp
IMAP_SMTP_HOST=smtp.gmail.com
IMAP_SMTP_PORT=465
IMAP_SMTP_SSL=true
IMAP_SMTP_AUTH=true

USE_FULLEMAIL_FOR_LOGIN=true
LOOSE_PROVISIONING=true
PROVISIONING=true
PING_INTERVAL=30
PING_HIGHER_BOUND_LIFETIME=900
USE_CUSTOM_REMOTE_IP_HEADER=HTTP_X_FORWARDED_FOR

# Logging / misc (see the root .env.example for all options)
LOG_TARGET=stdout
LOGLEVEL=WARN
LOGAUTHFAIL=false
IMAP_SMTP_VERIFY_PEER=true
