# Container env for the MXroute-style instance (users log in as user@example.com)
TIMEZONE=UTC
ZPUSH_HOST=eas.example.com

# Server hostname is account-specific: <server>.mxrouting.net (see your MXroute panel / welcome mail)
IMAP_SERVER=SERVER.mxrouting.net
IMAP_PORT=993
IMAP_OPTIONS=/ssl/norsh
IMAP_FOLDER_PREFIX=
IMAP_FOLDER_PREFIX_IN_INBOX=false
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_SENT=Sent
IMAP_FOLDER_DRAFT=Drafts
IMAP_FOLDER_TRASH=Trash
IMAP_FOLDER_SPAM=Junk
IMAP_FOLDER_ARCHIVE=Archive
IMAP_EXCLUDED_FOLDERS=

IMAP_SMTP_METHOD=smtp
IMAP_SMTP_HOST=SERVER.mxrouting.net
IMAP_SMTP_PORT=465
IMAP_SMTP_SSL=true
IMAP_SMTP_AUTH=true

USE_FULLEMAIL_FOR_LOGIN=true
LOOSE_PROVISIONING=true
PROVISIONING=true
PING_INTERVAL=30
PING_HIGHER_BOUND_LIFETIME=900
LOGLEVEL=INFO
USE_CUSTOM_REMOTE_IP_HEADER=HTTP_X_FORWARDED_FOR
