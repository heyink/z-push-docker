# Copy to .env and fill in. Never commit .env.
# Used both by compose (image, network, Caddy label hostnames) and, via env_file,
# by the container (everything else).

# ---------- deployment ----------
IMAGE=ghcr.io/heyink/z-push-docker:latest
# Docker network shared with lucaslorentz/caddy-docker-proxy
#   docker network ls
#   docker inspect <caddy_container> --format '{{json .NetworkSettings.Networks}}'
CADDY_NETWORK=caddy
# Public hostnames served by caddy-docker-proxy (must resolve to your VPS)
EAS_DOMAIN=eas.example.com
AUTODISCOVER_DOMAIN=autodiscover.example.com
# Host returned by Autodiscover (defaults to EAS_DOMAIN)
ZPUSH_HOST=eas.example.com
# IANA zone used for Z-Push, PHP and Apache logs (TZ is set from it)
TIMEZONE=UTC

# ---------- IMAP (incoming) ----------
IMAP_SERVER=imap.example.com
IMAP_PORT=993
# php imap_open flags: https://www.php.net/imap_open
# Default /ssl/norsh verifies the certificate. Only for self-signed servers:
#   IMAP_OPTIONS=/ssl/norsh/novalidate-cert
IMAP_OPTIONS=/ssl/norsh

# Special folders must match your provider (raw IMAP names, case-insensitive)
IMAP_FOLDER_PREFIX=
IMAP_FOLDER_PREFIX_IN_INBOX=false
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_SENT=Sent
IMAP_FOLDER_DRAFT=Drafts
IMAP_FOLDER_TRASH=Trash
IMAP_FOLDER_SPAM=Junk
IMAP_FOLDER_ARCHIVE=Archive
# Substring match, "|"-separated, UTF-8
IMAP_EXCLUDED_FOLDERS=

# Less common IMAP backend options (upstream defaults shown)
IMAP_AUTOSEEN_ON_DELETE=false
IMAP_INLINE_FORWARD=true
IMAP_SEARCH_CHARSET=UTF-8
# php-imap is built with Kerberos; GSSAPI is disabled so login never tries it.
# Set to an empty value to allow all mechanisms.
IMAP_DISABLE_AUTHENTICATOR=GSSAPI
IMAP_DEFAULTFROM=

# ---------- SMTP (outgoing) ----------
IMAP_SMTP_METHOD=smtp
IMAP_SMTP_HOST=smtp.example.com
IMAP_SMTP_PORT=465
IMAP_SMTP_AUTH=true
# true → implicit TLS (ssl://host, port 465); false → plain connect, STARTTLS if offered (587)
IMAP_SMTP_SSL=true
# Verify the SMTP server certificate (set false only for self-signed servers)
IMAP_SMTP_VERIFY_PEER=true
# EHLO name (defaults to ZPUSH_HOST)
IMAP_SMTP_EHLO=

# ---------- Z-Push core ----------
# Login with full email address (user@example.com) — matches most hosted IMAP
USE_FULLEMAIL_FOR_LOGIN=true
PROVISIONING=true
LOOSE_PROVISIONING=true
# Seconds between IMAP checks during a Ping (max push latency)
PING_INTERVAL=30
# Max heartbeat accepted from devices; keep below proxy timeouts (labels use 30m)
PING_HIGHER_BOUND_LIFETIME=900
PING_LOWER_BOUND_LIFETIME=false
RETRY_AFTER_DELAY=300
USE_CUSTOM_REMOTE_IP_HEADER=HTTP_X_FORWARDED_FOR
PHP_MEMORY_LIMIT=256M

# ---------- logging ----------
# stdout → `docker logs` (size capped by compose logging options)
# file   → /var/log/z-push/*.log, rotated at LOG_MAX_SIZE_MB, LOG_MAX_FILES kept
LOG_TARGET=stdout
LOGLEVEL=WARN
AUTODISCOVER_LOGLEVEL=WARN
# Log failed logins at WARN (e.g. for fail2ban)
LOGAUTHFAIL=false
LOG_MAX_SIZE_MB=20
LOG_MAX_FILES=5
